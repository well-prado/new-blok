{
  "schemaVersion": 1,
  "purpose": "Synthetic ADR 0021 audit fixtures. Each case runs one real decision (approval, reconciliation or deployment) against a fresh SQLite store under one audit condition and predeclares the error, the durable rows and the effect counts. Secret-shaped strings are synthetic.",
  "conditions": {
    "available": "audit composed and writable",
    "unavailable": "a SQLite trigger aborts every audit insert (the audit store is down)",
    "capacity": "the audit store is already full (MaxRecords=1, one record present)",
    "sensitive-actor": "the authenticated actor is credential-shaped (plain for approval, base64-encoded for reconciliation)",
    "not-composed": "the operation is composed without an audit journal"
  },
  "counts": {
    "decisions": "approval_decisions_v1 rows",
    "auditRecords": "audit_records_v1 rows",
    "authorized": "approval.Authorize succeeded for the decision (a dispatch it would permit)",
    "reconciliations": "journal_reconciliations rows",
    "committedOperations": "committed journal operations",
    "uncertainOperations": "uncertain journal operations",
    "plans": "upgrade plans returned",
    "mirrored": "records the optional mirror accepted"
  },
