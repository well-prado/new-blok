A workflow path that contains node directories would give their files two owners.
-- blok.json --
{"name":"shop","module":"example.com/shop","runtime":"go","layout":"classic","triggers":["http"],"types":"","workflows":["runtimes"]}
-- go.mod --
module example.com/shop
-- runtimes/go/nodes/quote/quote.go --
package quote

import "github.com/well-prado/new-blok/node"

var Node = node.MustDefine("shop/quote", "1.0.0", nil)
-- @expect --
{"diagnostics":[["layout_ownership_overlap","runtimes"]]}
