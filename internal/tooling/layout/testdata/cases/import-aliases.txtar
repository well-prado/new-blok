module example.com/shop

go 1.27.0
-- nodes/go/aliased/aliased.go --
package aliased

import blok "github.com/well-prado/new-blok/node"

const (
	namespace = "shop/"
	version   = "3.2.1"
)

var Node = blok.MustDefine[In, Out](namespace+"aliased", version, nil)
-- nodes/go/dotted/dotted.go --
package dotted

import . "github.com/well-prado/new-blok/node"

var Node, _ = Define[In, Out]("shop/dotted", "1.0.0", nil)
