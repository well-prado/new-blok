-- nodes/go/dead/dead.go --
package dead

import "github.com/well-prado/new-blok/node"

func New() (node.Definition[int, int], error) {
	return node.Define("shop/real", "1.0.0", nil)
	return node.Define("shop/dead", "1.0.0", nil)
}
-- nodes/go/branch/branch.go --
package branch

import "github.com/well-prado/new-blok/node"

func New(fast bool) (node.Definition[int, int], error) {
	if fast {
		return node.Define("shop/fast", "1.0.0", nil)
	}
	return node.Define("shop/slow", "1.0.0", nil)
}
-- nodes/go/good/good.go --
package good

import "github.com/well-prado/new-blok/node"

func New(define bool) (node.Definition[int, int], error) {
	return node.Define("shop/good", "1.0.0", nil)
}
