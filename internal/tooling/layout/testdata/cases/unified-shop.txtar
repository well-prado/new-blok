Unified layout of classic-shop with different directory names (calculate,
receipt). Identity comes from descriptors, so the catalog and digest equal
classic-shop's.
-- blok.json --
{"name":"shop","module":"example.com/shop","runtime":"go","layout":"unified","triggers":["http"],"types":"nodes/go/calculate/types.go"}
-- go.mod --
module example.com/shop

go 1.27.0
-- internal/money/money.go --
package money

// Cents is a shared domain utility nodes may import.
func Cents(units, price int64) int64 { return units * price }
-- nodes/go/calculate/quote.go --
package quote

import (
	"context"

	blok "github.com/well-prado/new-blok/node"

	"example.com/shop/internal/money"
	"example.com/shop/nodes/go/calculate/rates"
)

const name = "shop/calculate-quote"

// init would panic if discovery ever executed source.
func init() { panic("discovery executed source") }

var Node = blok.MustDefine(name, "1.0.0", func(ctx context.Context, in Input) (Output, error) {
	return Output{TotalCents: money.Cents(int64(in.Quantity), rates.Coffee)}, nil
})
-- nodes/go/calculate/types.go --
package quote

type Input struct {
	Quantity int `json:"quantity"`
}

type Output struct {
	TotalCents int64 `json:"totalCents"`
}
-- nodes/go/calculate/rates/rates.go --
package rates

const Coffee = 1500
-- nodes/go/calculate/quote_test.go --
package quote

import blok "github.com/well-prado/new-blok/node"

// Test files are not discovered: this identity must never reach the catalog.
var testOnly = blok.MustDefine("shop/test-only", "0.0.1", nil)
-- nodes/nodejs/receipt/node.json --
{"name":"shop/format-receipt","version":"2.1.0","runtime":"nodejs","description":"Formats a receipt","inputSchema":{"type":"object"},"outputSchema":{"type":"object"}}
-- nodes/nodejs/receipt/index.mjs --
export default function format(input) { return { text: String(input.total) }; }
-- workflows/quotes/quotes.go --
package quotes

import (
	"github.com/well-prado/new-blok/flow"

	quote "example.com/shop/nodes/go/calculate"
)

var _ = quote.Node

func New() (flow.Definition[int, int], error) {
	return flow.Define(flow.Spec{Name: "shop/quote", Version: "1.0.0"}, nil)
}
