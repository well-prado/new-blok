{
  "schemaVersion": 1,
  "evidenceClass": "synthetic-local-contract-comparison",
  "provider": {
    "name": "shared-parity-provider",
    "version": "1.0.0",
    "transport": "loopback-http",
    "externalCalls": false,
    "idempotencyHeader": "idempotency-key"
  },
  "workloads": [
    {
      "id": "quote-success",
      "operation": "quote",
      "request": { "requestKey": "quote-success", "sku": "coffee", "quantity": 2 },
      "expected": {
        "output": { "status": 200, "body": { "sku": "coffee", "quantity": 2, "totalCents": 3000, "currency": "USD" } },
        "errorCode": "",
        "providerCalls": 1,
        "committedEffects": 1
      }
    },
    {
      "id": "quote-invalid-sku",
      "operation": "quote",
      "request": { "requestKey": "quote-invalid", "sku": "not-in-catalog", "quantity": 1 },
      "expected": {
        "output": null,
        "errorCode": "unknown_sku",
        "providerCalls": 1,
        "committedEffects": 0,
        "oldRunner": { "ok": false, "errorCode": "", "errorMessage": "synthetic unknown sku", "providerCalls": 1, "committedEffects": 0 },
        "newNativeEngine": { "ok": false, "errorCode": "unknown_sku", "errorMessage": "unknown_sku: unknown_sku: synthetic unknown sku", "providerCalls": 1, "committedEffects": 0 }
      }
    },
    {
      "id": "order-duplicate-delivery",
      "operation": "order",
      "request": { "requestKey": "order-duplicate", "sku": "coffee", "quantity": 2 },
      "deliveries": 2,
      "expected": {
        "normalizedOutput": { "status": 200, "body": { "requestKey": "order-duplicate", "sku": "coffee", "quantity": 2, "totalCents": 3000 } },
        "providerCalls": 2,
        "committedEffects": 1
      }
    },
    {
      "id": "job-retry",
      "operation": "job-retry",
      "request": { "requestKey": "job-retry", "jobId": "job-108", "sku": "coffee", "quantity": 2 },
      "retry": { "maxAttempts": 2, "firstFailure": "temporary_provider_error" },
      "expected": {
        "oldRunner": { "ok": true, "providerCalls": 2, "committedEffects": 1 },
        "newNativeEngine": { "ok": false, "errorCode": "temporary_provider_error", "errorMessage": "temporary_provider_error: temporary_provider_error: synthetic first-attempt failure", "providerCalls": 1, "committedEffects": 0 },
        "newWorkerQueue": {
          "output": { "status": 200, "body": { "jobId": "job-108", "state": "completed", "totalCents": 3000 } },
          "providerCalls": 2,
          "committedEffects": 1
        }
      }
    },
    {
      "id": "order-reserve-commit-success",
      "operation": "reserve-commit",
      "request": { "requestKey": "order-reserve", "sku": "coffee", "quantity": 2 },
      "expected": {
        "output": { "status": 200, "body": { "requestKey": "order-reserve", "reserved": true } },
        "providerCalls": 2,
        "committedEffects": 2
      }
    },
    {
      "id": "order-cancel-in-flight",
      "operation": "reserve-commit",
      "request": { "requestKey": "order-cancel", "sku": "coffee", "quantity": 2 },
      "expected": {
        "cancellation": {
          "trigger": "caller disconnects the HTTP request while the reserve provider call is in flight",
          "reserveCalls": 1,
          "reserveAbortedByCaller": 1,
          "commitCalls": 0,
          "committedEffects": 0,
          "processServesAfterCancel": true
        }
      }
    },
    {
      "id": "webhook-duplicate",
      "operation": "webhook",
      "request": { "requestKey": "webhook-108", "eventId": "evt-108", "type": "order.created", "kind": "order.created", "orderId": "order-108" },
      "deliveries": 2,
      "expected": {
        "normalizedOutput": { "eventId": "evt-108", "type": "order.created", "kind": "order.created", "orderId": "order-108", "requestKey": "webhook-108" },
        "providerCalls": 1,
        "committedEffects": 1,
        "duplicateAcknowledged": true
      }
    },
    {
      "id": "stream-event-and-disconnect",
      "operation": "stream",
      "request": { "requestKey": "stream-108", "streamId": "stream-108", "events": [{ "id": "1", "event": "order", "data": { "orderId": "order-108", "state": "accepted" } }] },
      "expected": {
        "normalizedEvents": [{ "id": "1", "event": "order", "data": { "orderId": "order-108", "state": "accepted" } }],
        "oldSSETriggerDisconnectCancelsWorkflow": true,
        "newSSETriggerDisconnectPreservesAcceptedJob": true,
        "deliverySemanticsMatch": false
      }
    }
  ],
  "migratedWorkflows": {
    "triggerValue": "published Blok 2.x resolves a root `@trigger` reference to ctx.request, the request envelope {body, headers, query, params, method, url}; the converted workflow receives that same value as its input",
    "request": { "requestKey": "migrated-quote", "sku": "coffee", "quantity": 2 },
    "cases": [
      {
        "id": "converted-envelope-quote",
        "source": { "schemaVersion": "2", "name": "migrated quote", "version": "1.0.0", "trigger": { "http": {} }, "steps": [ { "id": "load", "use": "catalog-request", "inputs": { "$ref": { "step": "@trigger", "path": [] } } }, { "id": "total", "use": "price", "inputs": { "$ref": { "step": "load", "path": ["body"] } } } ] },
        "expected": { "supported": true, "output": { "sku": "coffee", "totalCents": 3000, "display": "3000 USD" }, "providerCalls": 1, "committedEffects": 1 }
      },
      {
        "id": "trigger-body-projection-runs-old-but-is-not-converted",
        "source": { "schemaVersion": "2", "name": "projected quote", "version": "1.0.0", "trigger": { "http": {} }, "steps": [ { "id": "load", "use": "catalog", "inputs": { "$ref": { "step": "@trigger", "path": ["body"] } } }, { "id": "total", "use": "price", "inputs": { "$ref": { "step": "load", "path": ["body"] } } } ] },
        "expected": { "supported": false, "code": "unsupported_trigger_projection", "path": "steps[0].inputs", "oldOutput": { "sku": "coffee", "totalCents": 3000, "display": "3000 USD" }, "providerCalls": 1, "committedEffects": 1 }
      }
    ]
  },
  "durableRecovery": {
    "trigger": "the producer process is SIGKILLed after durable acceptance of two submissions with the same job id; a fresh consumer process recovers the work",
    "providerFailsFirstAttempt": true,
    "expectedBody": { "state": "completed", "totalCents": 3000 },
    "old": {
      "adapter": "published PgBossAdapter, pg-boss 10.4.2 standard queue",
      "storedJobsAfterDuplicateSubmission": 2,
      "completed": 2,
      "failed": 1,
      "providerCalls": 3,
      "committedEffects": 1
    },
    "new": {
      "adapter": "trigger/worker.Queue on SQLite WAL synchronous=FULL",
      "storedJobsAfterDuplicateSubmission": 1,
      "completed": 1,
      "failed": 1,
      "attempts": 2,
      "providerCalls": 2,
      "committedEffects": 1
    },
    "duplicateSubmissionSemanticsMatch": false,
    "note": "PgBossAdapter maps jobId to pg-boss singletonKey, which a standard pg-boss 10 queue does not deduplicate; both stored jobs execute and only the provider idempotency key keeps the business effect single. The new queue deduplicates the request key at admission."
  },
  "midExecutionKill": {
    "trigger": "the consumer process is SIGKILLed while its provider call is in flight; a fresh consumer must redeliver the accepted job from durable storage",
    "expectedBody": { "state": "completed", "totalCents": 3000 },
    "old": {
      "adapter": "published PgBossAdapter, pg-boss 10.4.2 standard queue, per-job expireInSeconds=5",
      "redelivery": "pg-boss maintenance expires the orphaned active job and retries it; maintenance runs every 120 s by default and PgBossAdapter 2.5.0 exposes no option to change it",
      "completedByFreshConsumer": 1,
      "providerCalls": 2,
      "abortedByKill": 1,
      "committedEffects": 1
    },
    "new": {
      "adapter": "trigger/worker.Queue on SQLite WAL synchronous=FULL",
      "redelivery": "the claim, handler writes and acknowledgment share one SQLite transaction, so the kill rolls the claim back too; the fresh consumer claims the job immediately and the killed attempt leaves no durable attempt count",
      "completedByFreshConsumer": 1,
      "attempts": 1,
      "providerCalls": 2,
      "abortedByKill": 1,
      "committedEffects": 1
    }
  },
  "recovery": {
    "new": { "api": "trigger/worker.Queue", "expected": "accepted job remains durable and is processed after process restart" },
    "old": { "api": "trigger/worker.InMemoryAdapter", "expected": "job is lost after process restart; adapter explicitly has no persistence" },
    "comparison": "recovery guarantees differ; no workflow replay is inferred from persisted run traces"
  },
  "inertia": {
    "status": "separate-contract-required",
    "includedInBusinessParity": false,
    "reason": "Inertia page props, partial reloads, deferred props, flash and redirect semantics require their own client/server protocol contract"
  }
}
