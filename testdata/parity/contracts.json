  "businessWorkloads": {
    "class": "business-logic",
    "rules": "subtotal = unit x quantity; discount = floor(subtotal/10) when quantity >= 10; tax = floor(((subtotal - discount) x 825 + 5000) / 10000); total = subtotal - discount + tax; quantity must be an integer in [1, 100] (invalid_quantity)",
    "catalog": {
      "coffee": 1500,
      "tea": 900
    },
    "workloads": [
