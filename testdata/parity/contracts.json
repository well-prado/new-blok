{
  "schemaVersion": 1,
  "evidenceClass": "synthetic-local-contract-comparison",
  "provider": {
    "name": "shared-parity-provider",
    "version": "1.0.0",
    "transport": "loopback-http",
    "externalCalls": false,
    "idempotencyHeader": "idempotency-key"
  },
  "workloadClasses": {
    "plumbing": "one-step pass-through workflows whose business value is computed by the synthetic provider; they prove input mapping, idempotency headers, error classification, retry, cancellation, delivery and recovery plumbing, not business-logic equivalence",
    "business-logic": "multi-step workflows whose business values are computed by workflow nodes on each engine and carried between steps; the provider only supplies catalog data and records effects"
  },
