  "migratedWorkflows": {
    "triggerValue": "published Blok 2.x resolves a root `@trigger` reference to ctx.request, the request envelope {body, headers, query, params, method, url}; the converted workflow receives that same value as its input",
    "request": {
      "requestKey": "migrated-quote",
      "sku": "coffee",
      "quantity": 2
    },
    "cases": [
      {
        "id": "converted-envelope-quote",
        "source": {
          "schemaVersion": "2",
          "name": "migrated quote",
          "version": "1.0.0",
          "trigger": {
            "http": {}
          },
          "steps": [
            {
              "id": "load",
              "use": "catalog-request",
              "inputs": {
                "$ref": {
                  "step": "@trigger",
                  "path": []
                }
              }
            },
            {
              "id": "total",
              "use": "price",
              "inputs": {
                "$ref": {
                  "step": "load",
                  "path": [
                    "body"
                  ]
                }
              }
            }
          ]
        },
        "expected": {
          "supported": true,
          "output": {
            "sku": "coffee",
            "totalCents": 3000,
            "display": "3000 USD"
          },
          "providerCalls": 1,
          "committedEffects": 1
        }
      },
      {
        "id": "trigger-body-projection-runs-old-but-is-not-converted",
        "source": {
          "schemaVersion": "2",
          "name": "projected quote",
          "version": "1.0.0",
          "trigger": {
            "http": {}
          },
          "steps": [
            {
              "id": "load",
              "use": "catalog",
              "inputs": {
                "$ref": {
                  "step": "@trigger",
                  "path": [
                    "body"
                  ]
                }
              }
            },
            {
              "id": "total",
              "use": "price",
              "inputs": {
                "$ref": {
                  "step": "load",
                  "path": [
                    "body"
                  ]
                }
              }
            }
          ]
        },
        "expected": {
          "supported": false,
          "code": "unsupported_trigger_projection",
          "path": "steps[0].inputs",
          "oldOutput": {
            "sku": "coffee",
            "totalCents": 3000,
            "display": "3000 USD"
          },
          "providerCalls": 1,
          "committedEffects": 1
        }
      }
    ]
  },
  "durableRecovery": {
    "trigger": "the producer process is SIGKILLed after durable acceptance of two submissions with the same job id; a fresh consumer process recovers the work",
    "providerFailsFirstAttempt": true,
    "expectedBody": {
      "state": "completed",
      "totalCents": 3000
    },
    "old": {
      "adapter": "published PgBossAdapter, pg-boss 10.4.2 standard queue",
      "storedJobsAfterDuplicateSubmission": 2,
      "completed": 2,
      "failed": 1,
      "providerCalls": 3,
      "committedEffects": 1
    },
    "new": {
      "adapter": "trigger/worker.Queue on SQLite WAL synchronous=FULL",
      "storedJobsAfterDuplicateSubmission": 1,
      "completed": 1,
      "failed": 1,
      "attempts": 2,
      "providerCalls": 2,
      "committedEffects": 1
    },
    "duplicateSubmissionSemanticsMatch": false,
    "note": "PgBossAdapter maps jobId to pg-boss singletonKey, which a standard pg-boss 10 queue does not deduplicate; both stored jobs execute and only the provider idempotency key keeps the business effect single. The new queue deduplicates the request key at admission."
  },
  "midExecutionKill": {
    "trigger": "the consumer process is SIGKILLed while its provider call is in flight; a fresh consumer must redeliver the accepted job from durable storage",
    "expectedBody": {
      "state": "completed",
      "totalCents": 3000
    },
    "old": {
      "adapter": "published PgBossAdapter, pg-boss 10.4.2 standard queue, per-job expireInSeconds=5",
      "redelivery": "pg-boss maintenance expires the orphaned active job and retries it; maintenance runs every 120 s by default and PgBossAdapter 2.5.0 exposes no option to change it",
      "completedByFreshConsumer": 1,
      "providerCalls": 2,
      "abortedByKill": 1,
      "committedEffects": 1
    },
    "new": {
      "adapter": "trigger/worker.Queue on SQLite WAL synchronous=FULL",
      "redelivery": "the claim commits the started attempt and a 30 s lease before the handler runs; the handler writes and acknowledgment share a second SQLite transaction, which the kill rolls back. The fresh consumer claims the job once the lease expires, as its second attempt",
      "attemptsNote": "#245: a process-killed attempt consumes MaxAttempts, so the recovered completion is attempt 2",
      "completedByFreshConsumer": 1,
      "attempts": 2,
      "providerCalls": 2,
      "abortedByKill": 1,
      "committedEffects": 1
    }
  },
  "recovery": {
    "new": {
      "api": "trigger/worker.Queue",
      "expected": "accepted job remains durable and is processed after process restart"
    },
    "old": {
      "api": "trigger/worker.InMemoryAdapter",
      "expected": "job is lost after process restart; adapter explicitly has no persistence"
    },
    "comparison": "recovery guarantees differ; no workflow replay is inferred from persisted run traces"
  },
  "inertia": {
    "status": "separate-contract-required",
    "includedInBusinessParity": false,
    "reason": "Inertia page props, partial reloads, deferred props, flash and redirect semantics require their own client/server protocol contract"
  }
}
