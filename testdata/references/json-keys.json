{
  "schemaVersion": 1,
  "issue": 241,
  "decision": "docs/decisions/0001-public-api-boundaries.md#field-references-select-encodingjson-keys-241",
  "purpose": "Synthetic reference-resolution fixtures. Each case names a Go source value defined in internal/engine/reference_test.go; the test resolves the path against that value as a typed node output AND as its encoding/json-decoded form, and both must produce exactly the expected outcome. 'value' is the JSON encoding of the resolved value; 'error' is the message carried by invalid_output_reference. A field selected from a typed value is handed on as its Go value; where encoding/json would reach it through a pointer-receiver marshaler (inside a pointer output), the reference test asserts its Go type instead of a by-value JSON row.",
  "cases": [
    {"id": "tag-name-selects-field", "kind": "valid", "source": "tagged", "path": ["sku"], "expected": {"value": "coffee"}},
    {"id": "go-name-of-tagged-field-is-not-a-key", "kind": "rejected", "source": "tagged", "path": ["SKU"], "expected": {"error": "field \"SKU\" is missing"}},
    {"id": "untagged-field-uses-exact-go-name", "kind": "valid", "source": "tagged", "path": ["TotalCents"], "expected": {"value": 3000}},
    {"id": "untagged-field-is-case-sensitive", "kind": "rejected", "source": "tagged", "path": ["totalCents"], "expected": {"error": "field \"totalCents\" is missing"}},

    {"id": "promoted-tagged-field-is-flattened", "kind": "valid", "source": "embedded", "path": ["id"], "expected": {"value": "b-1"}},
    {"id": "promoted-untagged-field-is-flattened", "kind": "valid", "source": "embedded", "path": ["Note"], "expected": {"value": "base note"}},
    {"id": "embedded-type-name-is-not-a-key", "kind": "rejected", "source": "embedded", "path": ["RefBase"], "expected": {"error": "field \"RefBase\" is missing"}},
    {"id": "promoted-through-embedded-pointer", "kind": "valid", "source": "embeddedPointer", "path": ["id"], "expected": {"value": "b-1"}},
    {"id": "nil-embedded-pointer-promotes-nothing", "kind": "rejected", "source": "embeddedNilPointer", "path": ["id"], "expected": {"error": "field \"id\" is missing"}},
    {"id": "tagged-embedded-struct-is-a-nested-object", "kind": "valid", "source": "embeddedTagged", "path": ["base", "id"], "expected": {"value": "b-1"}},
    {"id": "tagged-embedded-struct-is-not-flattened", "kind": "rejected", "source": "embeddedTagged", "path": ["id"], "expected": {"error": "field \"id\" is missing"}},
    {"id": "shallower-field-shadows-promoted-field", "kind": "valid", "source": "shadowed", "path": ["id"], "expected": {"value": "outer"}},
    {"id": "ambiguous-promoted-fields-are-dropped", "kind": "rejected", "source": "ambiguous", "path": ["Note"], "expected": {"error": "field \"Note\" is missing"}},
    {"id": "tagged-field-dominates-untagged-at-same-depth", "kind": "valid", "source": "tagDominates", "path": ["Key"], "expected": {"value": "tagged"}},
    {"id": "embedded-non-struct-uses-type-name", "kind": "valid", "source": "embeddedLabel", "path": ["Label"], "expected": {"value": "gold"}},

    {"id": "dash-field-is-unreachable-by-go-name", "kind": "rejected", "source": "hidden", "path": ["Secret"], "expected": {"error": "field \"Secret\" is missing"}},
    {"id": "dash-comma-field-is-the-key-dash", "kind": "valid", "source": "hidden", "path": ["-"], "expected": {"value": "dash"}},

    {"id": "omitempty-empty-field-is-missing", "kind": "rejected", "source": "omitEmpty", "path": ["note"], "expected": {"error": "field \"note\" is missing"}},
    {"id": "omitempty-set-field-is-present", "kind": "valid", "source": "omitEmptySet", "path": ["note"], "expected": {"value": "kept"}},
    {"id": "omitzero-zero-field-is-missing", "kind": "rejected", "source": "omitZero", "path": ["at"], "expected": {"error": "field \"at\" is missing"}},
    {"id": "string-option-integer-is-a-string", "kind": "valid", "source": "stringOption", "path": ["n"], "expected": {"value": "5"}},
    {"id": "string-option-string-is-json-quoted", "kind": "valid", "source": "stringOption", "path": ["s"], "expected": {"value": "\"hi\""}},
    {"id": "string-option-nil-pointer-is-null", "kind": "valid", "source": "stringOption", "path": ["p"], "expected": {"value": null}},

    {"id": "custom-marshaler-keys-are-its-json-keys", "kind": "valid", "source": "money", "path": ["amount"], "expected": {"value": "15.00"}},
    {"id": "custom-marshaler-go-field-is-not-a-key", "kind": "rejected", "source": "money", "path": ["Cents"], "expected": {"error": "field \"Cents\" is missing"}},
    {"id": "raw-message-is-navigated-as-json", "kind": "valid", "source": "raw", "path": ["extra", "k"], "expected": {"value": "v"}},
    {"id": "bytes-are-a-json-string", "kind": "rejected", "source": "raw", "path": ["bytes", "x"], "expected": {"error": "cannot read \"x\" from a JSON string"}},
    {"id": "interface-field-holding-struct-is-flattened", "kind": "valid", "source": "boxed", "path": ["data", "id"], "expected": {"value": "b-1"}},
    {"id": "pointer-output-is-flattened", "kind": "valid", "source": "pointerRoot", "path": ["id"], "expected": {"value": "b-1"}},

    {"id": "named-string-map-key", "kind": "valid", "source": "namedKeyMap", "path": ["a"], "expected": {"value": 1}},
    {"id": "integer-map-key-is-its-decimal-text", "kind": "valid", "source": "intKeyMap", "path": ["7"], "expected": {"value": "seven"}},
    {"id": "integer-map-key-needs-canonical-text", "kind": "rejected", "source": "intKeyMap", "path": ["07"], "expected": {"error": "field \"07\" is missing"}},
    {"id": "text-marshaled-map-key-is-its-text", "kind": "valid", "source": "textKeyMap", "path": ["X"], "expected": {"value": 1}},
    {"id": "text-marshaled-map-key-raw-string-is-not-a-key", "kind": "rejected", "source": "textKeyMap", "path": ["x"], "expected": {"error": "field \"x\" is missing"}},
    {"id": "pointer-receiver-marshaler-applies-when-addressable", "kind": "valid", "source": "addressable", "path": ["in", "ptr"], "expected": {"value": true}},
    {"id": "pointer-receiver-marshaler-skipped-when-not-addressable", "kind": "valid", "source": "notAddressable", "path": ["in", "A"], "expected": {"value": 0}},
    {"id": "pointer-receiver-marshaler-in-pointer-output-is-navigated-as-json", "kind": "rejected", "source": "orderPointer", "path": ["order", "Price", "Cents"], "expected": {"error": "cannot read \"Cents\" from a JSON string"}},
    {"id": "pointer-receiver-marshaler-in-value-output-is-a-struct", "kind": "valid", "source": "orderValue", "path": ["order", "Price", "Cents"], "expected": {"value": 1500}},
    {"id": "duplicate-embedded-type-fields-are-ambiguous", "kind": "rejected", "source": "twice", "path": ["V"], "expected": {"error": "field \"V\" is missing"}},
    {"id": "duplicate-custom-names-keep-the-last", "kind": "valid", "source": "duplicateNames", "path": ["a"], "expected": {"value": 2}},
    {"id": "nil-map-is-null", "kind": "rejected", "source": "nilMap", "path": ["x"], "expected": {"error": "cannot read \"x\" from null"}},
    {"id": "number-cannot-be-descended", "kind": "rejected", "source": "tagged", "path": ["TotalCents", "x"], "expected": {"error": "cannot read \"x\" from a JSON number"}}
  ]
}
