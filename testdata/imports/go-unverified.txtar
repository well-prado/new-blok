Regions the Go adapter cannot verify are reported and never verified: an
import of a module path with no package, a package plugin load, a
//go:linkname directive and a syntax error in a shared package. Each is
attributed to the node that reaches it.
-- blok.json --
{"name":"shop","module":"example.com/shop","runtime":"go","layout":"unified","triggers":["http"],"types":""}
-- go.mod --
module example.com/shop
-- internal/broken/broken.go --
package broken

func (
-- nodes/go/a/a.go --
package a

import (
	"github.com/well-prado/new-blok/node"

	_ "example.com/shop/internal/missing"
)

var Node = node.MustDefine("shop/a", "1.0.0", nil)
-- nodes/go/b/b.go --
package b

import (
	"plugin"

	"github.com/well-prado/new-blok/node"
)

var _ = plugin.Open

var Node = node.MustDefine("shop/b", "1.0.0", nil)
-- nodes/go/c/c.go --
package c

import (
	_ "unsafe"

	"github.com/well-prado/new-blok/node"
)

//go:linkname hidden example.com/shop/nodes/go/b.Node
var hidden any

var Node = node.MustDefine("shop/c", "1.0.0", nil)
-- nodes/go/d/d.go --
package d

import (
	"github.com/well-prado/new-blok/node"

	_ "example.com/shop/internal/broken"
)

var Node = node.MustDefine("shop/d", "1.0.0", nil)
-- @expect --
{"nodes":[["nodes/go/a","unverified"],["nodes/go/b","unverified"],["nodes/go/c","unverified"],["nodes/go/d","unverified"]],"diagnostics":[["ownership_import_unresolved","nodes/go/a/a.go:6"],["ownership_parse_failed","internal/broken/broken.go:3"],["ownership_unsupported_form","nodes/go/b/b.go:4"],["ownership_unsupported_form","nodes/go/c/c.go:9"]]}
