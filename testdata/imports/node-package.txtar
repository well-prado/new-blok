{"nodes":[["nodes/nodejs/a","violation"],["nodes/nodejs/b","verified"],["nodes/nodejs/c","violation"],["nodes/nodejs/d","violation"],["nodes/nodejs/e","violation"]],"diagnostics":[["ownership_node_imports_node","nodes/nodejs/a/index.ts:1"],["ownership_node_imports_node","nodes/nodejs/c/index.ts:1"],["ownership_node_imports_node","nodes/nodejs/d/index.ts:1"],["ownership_transitive_node_import","nodes/nodejs/e/index.ts:1"]]}
