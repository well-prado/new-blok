{
  "schemaVersion": "journal/v2",
  "cases": [
    {
      "name": "concurrent duplicate admission",
      "expect": {
        "callers": 32,
        "accepted": 1,
        "runIds": 1,
        "storedRuns": 1,
        "conflictingReuse": "request_conflict",
        "observableEffects": 0
      }
    },
    {
      "name": "committed result replay",
      "expect": {
        "attempts": 2,
        "providerOperationKeys": 1,
        "committedAttempts": 1,
        "replayState": "committed",
        "replayResult": "{\"charged\":true}",
        "redispatchAfterReopen": "not_dispatchable"
      }
    },
    {
      "name": "uncertain external outcome",
      "expect": {
        "state": "uncertain",
        "redispatch": "uncertain",
        "completeRun": "uncertain",
        "reconciledState": "committed",
        "redispatchAfterReconcile": "not_dispatchable",
        "completeRunAfterReconcile": "ok"
      }
    },
    {
      "name": "new replay lineage",
      "expect": {
        "runIdentity": "fresh",
        "lineage": "source_run_id",
        "operationIdentity": "fresh",
        "reusedReplayKey": "request_conflict"
      }
    },
    {
      "name": "stale attempt result",
      "expect": {
        "stalePublish": "stale_attempt",
        "currentAttemptWins": true
      }
    },
    {
      "name": "integrity failure",
      "expect": {
        "truncatedStore": "fails_closed"
      }
    },
    {
      "name": "write failure",
      "expect": {
        "simulatedDiskFull": "fails_closed",
        "acknowledged": false,
        "storedRuns": 0,
        "acceptedAfterRecovery": true
      }
    }
  ],
  "crashBarriers": [
    {"name": "admission", "before": "not accepted", "after": "accepted"},
    {"name": "effect intent", "before": "absent", "after": "intent"},
    {"name": "attempt dispatch", "before": "intent", "after": "dispatched"},
    {"name": "result commit", "before": "dispatched", "after": "committed"},
    {"name": "completion acknowledgment", "before": "accepted", "after": "completed"}
  ],
  "limits": [
    "External effects are not executed by this journal; effect providers must use the stable provider operation key.",
    "Uncertain outcomes require reconciliation and are never silently retried.",
    "The write failure is simulated by a store that refuses before its transaction; TestRealDiskFullFailsClosedAndReopensIntact covers a real ENOSPC on Linux.",
    "Crash evidence covers one local SQLite filesystem and does not prove disk-loss survival or multi-host failover."
  ]
}
