    {
      "id": "inspect-redaction-and-references",
      "command": "inspect",
      "fields": "nodes,descriptions,sources,tests,examples,schemas",
      "layouts": [
        "classic"
      ],
      "golden": true,
      "edits": [
        {
          "file": "{node}/audit.go",
          "write": "package quote\n\nimport (\n\t\"context\"\n\n\t\"github.com/well-prado/new-blok/node\"\n)\n\nvar auditSchema = []byte(`{\"type\":\"object\",\"properties\":{\"password\":{\"type\":\"string\",\"default\":\"hunter2-fixture\"}}}`)\n\n// Audit's description and schema carry credential-shaped values.\nvar Audit = node.MustDefine(\"app/audit\", \"1.0.0\", func(_ context.Context, input Input) (Input, error) { return input, nil }, node.Description(\"calls the ledger with Authorization: Bearer fixture-token-0123456789abcdef\"), node.Schemas(auditSchema, auditSchema), node.Effects(\"ledger.write\"))\n"
        },
        {
          "file": "{node}/audit_test.go",
          "write": "package quote\n\nimport (\n\t\"fmt\"\n\t\"testing\"\n)\n\nfunc TestAuditDescriptor(t *testing.T) {\n\tif Audit.Descriptor().Name != \"app/audit\" {\n\t\tt.Fatal(Audit.Descriptor().Name)\n\t}\n}\n\nfunc ExampleAudit() {\n\tfmt.Println(Audit.Descriptor().Name)\n\t// Output: app/audit\n}\n"
        }
      ],
      "expected": {
        "exitCode": 0,
        "status": "passed",
        "outputRecords": 2,
        "errorRecords": 0,
        "effectRecords": 0,
        "redacted": 3,
        "diagnostics": []
      }
    },
